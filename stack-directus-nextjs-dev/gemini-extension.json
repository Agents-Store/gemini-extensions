{
  "name": "stack-directus-nextjs-dev",
  "version": "1.0.3",
  "description": "Directus + Next.js stack dev plugin. Integrates Directus headless CMS with Next.js App Router for content-driven applications.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "directus": {
      "httpUrl": "${NEXT_PUBLIC_DIRECTUS_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${DIRECTUS_ADMIN_TOKEN}"
      }
    }
  },
  "settings": [
    {
      "name": "DIRECTUS ADMIN TOKEN",
      "description": "Required by stack-directus-nextjs-dev's MCP server(s).",
      "envVar": "DIRECTUS_ADMIN_TOKEN",
      "sensitive": true
    },
    {
      "name": "NEXT PUBLIC DIRECTUS URL",
      "description": "Required by stack-directus-nextjs-dev's MCP server(s).",
      "envVar": "NEXT_PUBLIC_DIRECTUS_URL",
      "sensitive": false
    }
  ]
}