{
  "name": "stack-directus-nextjs-trigger-dev",
  "version": "1.0.2",
  "description": "Directus + Next.js + Trigger.dev stack dev plugin. Adds self-hosted Trigger.dev as a workflow engine for AI agents, durable async logic, and scheduled jobs on top of the Directus + Next.js App Router stack.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "directus": {
      "httpUrl": "${NEXT_PUBLIC_DIRECTUS_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${DIRECTUS_ADMIN_TOKEN}"
      }
    },
    "trigger-dev": {
      "command": "npx",
      "args": [
        "trigger.dev@latest",
        "mcp"
      ],
      "env": {
        "TRIGGER_ACCESS_TOKEN": "${TRIGGER_SECRET_KEY}",
        "TRIGGER_API_URL": "${TRIGGER_API_URL}"
      }
    }
  },
  "settings": [
    {
      "name": "DIRECTUS ADMIN TOKEN",
      "description": "Required by stack-directus-nextjs-trigger-dev's MCP server(s).",
      "envVar": "DIRECTUS_ADMIN_TOKEN",
      "sensitive": true
    },
    {
      "name": "NEXT PUBLIC DIRECTUS URL",
      "description": "Required by stack-directus-nextjs-trigger-dev's MCP server(s).",
      "envVar": "NEXT_PUBLIC_DIRECTUS_URL",
      "sensitive": false
    },
    {
      "name": "TRIGGER API URL",
      "description": "Required by stack-directus-nextjs-trigger-dev's MCP server(s).",
      "envVar": "TRIGGER_API_URL",
      "sensitive": false
    },
    {
      "name": "TRIGGER SECRET KEY",
      "description": "Required by stack-directus-nextjs-trigger-dev's MCP server(s).",
      "envVar": "TRIGGER_SECRET_KEY",
      "sensitive": true
    }
  ]
}