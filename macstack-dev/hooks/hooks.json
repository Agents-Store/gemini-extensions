{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${extensionPath}/hooks/session-start-macstack-stale.py\"",
          "timeout": 15000
        }
      ]
    }
  ],
  "AfterAgent": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${extensionPath}/hooks/stop-macstack-stale.py\"",
          "timeout": 15000
        }
      ]
    }
  ]
}