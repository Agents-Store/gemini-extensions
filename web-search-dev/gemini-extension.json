{
  "name": "web-search-dev",
  "version": "1.2.0",
  "description": "Developer reference for web search, scraping and documentation lookup — Firecrawl, Exa, Jina, Perplexity, Context7 MCP tools and REST/SDK/CLI — plus Pexels and Unsplash REST media search.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_TOKEN}"
      }
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "perplexity": {
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "jina": {
      "httpUrl": "https://mcp.jina.ai/v1",
      "headers": {
        "Authorization": "Bearer ${JINA_API_KEY}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ]
    }
  },
  "settings": [
    {
      "name": "CONTEXT7 API KEY",
      "description": "Required by web-search-dev's MCP server(s).",
      "envVar": "CONTEXT7_API_KEY",
      "sensitive": true
    },
    {
      "name": "EXA API KEY",
      "description": "Required by web-search-dev's MCP server(s).",
      "envVar": "EXA_API_KEY",
      "sensitive": true
    },
    {
      "name": "FIRECRAWL API TOKEN",
      "description": "Required by web-search-dev's MCP server(s).",
      "envVar": "FIRECRAWL_API_TOKEN",
      "sensitive": true
    },
    {
      "name": "JINA API KEY",
      "description": "Required by web-search-dev's MCP server(s).",
      "envVar": "JINA_API_KEY",
      "sensitive": true
    },
    {
      "name": "PERPLEXITY API KEY",
      "description": "Required by web-search-dev's MCP server(s).",
      "envVar": "PERPLEXITY_API_KEY",
      "sensitive": true
    }
  ]
}