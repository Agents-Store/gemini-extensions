{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${extensionPath}/hooks/session-start-seen-skills.mjs\""
        },
        {
          "type": "command",
          "command": "node \"${extensionPath}/hooks/session-start-profiler.mjs\""
        },
        {
          "type": "command",
          "command": "node \"${extensionPath}/hooks/inject-claude-md.mjs\""
        }
      ]
    }
  ],
  "AfterTool": [
    {
      "matcher": "Skill",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${extensionPath}/hooks/posttooluse-skill-telemetry.mjs\"",
          "timeout": 5000
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${extensionPath}/hooks/session-end-cleanup.mjs\""
        }
      ]
    }
  ]
}