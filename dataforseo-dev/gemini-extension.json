{
  "name": "dataforseo-dev",
  "version": "1.0.0",
  "description": "DataForSEO data analysis plugin. Keyword research, competitor analysis, backlink auditing, SERP monitoring, on-page audits, content analysis, and AI optimization via 70+ MCP tools.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "dataforseo": {
      "command": "npx",
      "args": [
        "-y",
        "dataforseo-mcp-server@latest"
      ],
      "env": {
        "DATAFORSEO_USERNAME": "${DATAFORSEO_USERNAME}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    }
  },
  "settings": [
    {
      "name": "DATAFORSEO PASSWORD",
      "description": "Required by dataforseo-dev's MCP server(s).",
      "envVar": "DATAFORSEO_PASSWORD",
      "sensitive": true
    },
    {
      "name": "DATAFORSEO USERNAME",
      "description": "Required by dataforseo-dev's MCP server(s).",
      "envVar": "DATAFORSEO_USERNAME",
      "sensitive": false
    }
  ]
}