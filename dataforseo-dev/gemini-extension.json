{
  "name": "dataforseo-dev",
  "version": "2.0.1",
  "description": "DataForSEO data for SEO work — keywords, SERP, backlinks, on-page, AI visibility — through the v3 MCP server. Not a general web-search tool.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "dataforseo": {
      "command": "npx",
      "args": [
        "-y",
        "dataforseo-mcp-server@3"
      ],
      "env": {
        "DATAFORSEO_USERNAME": "${DATAFORSEO_USERNAME}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD}"
      }
    }
  },
  "settings": [
    {
      "name": "DATAFORSEO PASSWORD",
      "description": "Required by dataforseo-dev's MCP server(s).",
      "envVar": "DATAFORSEO_PASSWORD",
      "sensitive": true
    },
    {
      "name": "DATAFORSEO USERNAME",
      "description": "Required by dataforseo-dev's MCP server(s).",
      "envVar": "DATAFORSEO_USERNAME",
      "sensitive": false
    }
  ]
}