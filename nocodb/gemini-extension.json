{
  "name": "nocodb",
  "version": "1.0.0",
  "description": "NocoDB database development plugin. Manage tables, records, columns, views, relations, formulas, rollups, lookups, filtering, sorting, search, aggregation, webhooks, and filter/sort management via MCP tools.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "nocodb": {
      "httpUrl": "${NOCODB_MCP_URL}",
      "headers": {
        "xc-mcp-token": "${NOCODB_MCP_TOKEN}"
      }
    }
  },
  "settings": [
    {
      "name": "NOCODB MCP TOKEN",
      "description": "Required by nocodb's MCP server(s).",
      "envVar": "NOCODB_MCP_TOKEN",
      "sensitive": true
    },
    {
      "name": "NOCODB MCP URL",
      "description": "Required by nocodb's MCP server(s).",
      "envVar": "NOCODB_MCP_URL",
      "sensitive": false
    }
  ]
}