{
  "BeforeTool": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${extensionPath}/hooks/guard.py\"",
          "timeout": 10000
        }
      ]
    },
    {
      "matcher": "mcp__plugin_stack-ads_(meta-ads|tiktok-ads|google-ads)__.*",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${extensionPath}/hooks/guard.py\"",
          "timeout": 10000
        }
      ]
    }
  ]
}